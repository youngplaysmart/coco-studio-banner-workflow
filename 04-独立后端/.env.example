# 插件请求时带上的口令（插件面板「设置」里填同一个值）。留空则不校验。
COCO_API_TOKEN=

# ---- 读取需求：二选一或都配 ----
# A. 直接读 Jira Cloud
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# B. 复用现有 Gradio（链接 → 基础需求）
GRADIO_URL=
GRADIO_API_NAME=/predict

# ---- 需求拆解（不填则用规则兜底）----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- 生图：mock | openai | weave ----
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
# Coco 标准形象（画布上没放角色图时使用）
COCO_REF_PATH=./assets/coco.png
